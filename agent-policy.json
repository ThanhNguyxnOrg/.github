{
  "schemaVersion": 1,
  "organization": "ThanhNguyxnOrg",
  "pollIntervalMinutes": 10,
  "reviewers": [
    "RealThanhNguyxn",
    "ThanhNguyxn07"
  ],
  "labels": {
    "triageNeeded": {
      "color": "D4C5F9",
      "description": "Needs initial triage by a repository maintainer."
    },
    "needsReview": {
      "color": "D93F0B",
      "description": "ThanhNguyxnAgent held this item for human review."
    },
    "majorUpdate": {
      "color": "FBCA04",
      "description": "Major dependency update; human review required."
    },
    "workflowUpdate": {
      "color": "5319E7",
      "description": "GitHub Actions or repository workflow change; human review required."
    },
    "ciFailed": {
      "color": "B60205",
      "description": "One or more required checks failed."
    },
    "ciPending": {
      "color": "FBCA04",
      "description": "Checks have not completed successfully."
    },
    "ciMissing": {
      "color": "C5DEF5",
      "description": "No successful check evidence was found."
    },
    "mergeConflict": {
      "color": "B60205",
      "description": "Pull request has merge conflicts."
    },
    "security": {
      "color": "D73A4A",
      "description": "Security-sensitive issue or change; human review required."
    },
    "bug": {
      "color": "D73A4A",
      "description": "Bug report."
    },
    "enhancement": {
      "color": "A2EEEF",
      "description": "Feature request or enhancement."
    },
    "documentation": {
      "color": "0075CA",
      "description": "Documentation issue or change."
    },
    "question": {
      "color": "D876E3",
      "description": "Question requiring maintainer response."
    },
    "skillVerificationPending": {
      "color": "FBCA04",
      "description": "A project-specific validation adapter is running; the central Agent defers PR triage until it finishes."
    },
    "automated": {
      "color": "EDEDED",
      "description": "PR created by an automation bot; requires maintainer review."
    },
    "dependencies": {
      "color": "0366D6",
      "description": "Dependency or package manifest update."
    },
    "frontend": {
      "color": "1D76DB",
      "description": "Changes affecting frontend or user-interface code."
    },
    "backend": {
      "color": "0052CC",
      "description": "Changes affecting backend, API, services, or system components."
    },
    "tests": {
      "color": "FBCA04",
      "description": "Changes affecting automated tests or test fixtures."
    },
    "maintenance": {
      "color": "C2E0C6",
      "description": "Maintenance, refactoring, performance, build, or CI changes."
    },
    "release": {
      "color": "5319E7",
      "description": "Release metadata, changelog, or release automation change."
    }
  },
  "blockingLabels": [
    "needs-review",
    "do-not-merge",
    "breaking",
    "breaking-change",
    "security",
    "wip",
    "major-update",
    "ci-failed",
    "merge-conflict"
  ],
  "ignoredIssueLabels": [
    "automated",
    "incident",
    "keep-me",
    "stale",
    "wontfix"
  ],
  "ignoredRepositories": [
    ".github"
  ],
  "repositories": {
    "WriteCanvas": {
      "sensitivePaths": [
        "main/**",
        "preload.js",
        ".github/workflows/**"
      ]
    },
    "Techstack-Studio": {
      "sensitivePaths": [
        "scripts/buildCatalogManifest*",
        "scripts/generateStandaloneSvgLibrary*",
        ".github/workflows/**"
      ]
    },
    "LayoutLingua": {
      "sensitivePaths": [
        "layoutlingua/**",
        ".github/workflows/**"
      ]
    },
    "apidex-hub": {
      "sensitivePaths": [
        "apis/**",
        "scripts/remove_dead_links.py",
        "scripts/check_links.py",
        "scripts/verify_links_playwright.py",
        ".github/workflows/link-checker.yml",
        ".github/ai-instructions.md",
        "site/src/data/apis.json"
      ]
    }
  },
  "stalePolicy": {
    "daysBeforeStale": 14,
    "daysBeforeClose": 5,
    "exemptLabels": [
      "keep-me",
      "incident",
      "automated",
      "security",
      "needs-review",
      "ci-failed",
      "ci-pending",
      "ci-missing",
      "merge-conflict",
      "workflow-update",
      "wip",
      "pinned",
      "skill-verification-pending"
    ],
    "activityTimestampToleranceMinutes": 5
  }
}
