{
  "schemaVersion": 1,
  "organization": "ThanhNguyxnOrg",
  "defaults": {
    "autoMergeDependabot": true,
    "requiredChecks": []
  },
  "repositories": {
    "judgeloom-core": {
      "defaultBranch": "master",
      "requiredChecks": [
        "Lint • Typecheck • Test (Python 3.12)",
        "go-test / Go worker test • vet"
      ]
    },
    "blendops": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify (BlendOps)"
      ]
    },
    "apidex-hub": {
      "defaultBranch": "main",
      "requiredChecks": [
        {
          "name": "check-links",
          "paths": [
            "apis/**",
            "scripts/**",
            ".github/workflows/link-checker.yml"
          ]
        },
        {
          "name": "regression-tests / Python Regression Tests",
          "paths": [
            "scripts/**",
            ".github/workflows/script-tests.yml"
          ]
        },
        {
          "name": "lint",
          "paths": [
            "**/*.md",
            ".markdownlint.json",
            ".github/workflows/markdownlint.yml"
          ]
        },
        {
          "name": "website / Website Build",
          "paths": [
            "site/**"
          ]
        }
      ],
      "autoMerge": {
        "label": "automerge",
        "branchPrefix": "agent-remediation/",
        "sameRepository": true,
        "paths": [
          "apis/**",
          "README.md",
          "site/index.html",
          "site/src/data/apis.json"
        ],
        "allowTriageBypass": true,
        "allowSensitivePaths": true,
        "author": "thanhnguyxnagent[bot]"
      }
    },
    "lumeo": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / lint-and-syntax"
      ]
    },
    "cogmint": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Typecheck"
      ]
    },
    "awesome-cert-sherpa": {
      "defaultBranch": "main",
      "requiredChecks": [
        "build / Build & Validate"
      ]
    },
    "Snapbooth": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Smoke & E2E"
      ]
    },
    "Locsight": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Registry & Release Script",
        "build-tauri (windows-latest, x64)",
        "build-tauri (macos-latest, x64)",
        "build-tauri (ubuntu-latest, x64)"
      ]
    },
    "PurgeKit": {
      "defaultBranch": "main",
      "requiredChecks": [
        "frontend / Frontend (Svelte & TypeScript)",
        "Rust Compiler Check"
      ]
    },
    "LayoutLingua": {
      "defaultBranch": "main",
      "requiredChecks": [
        {
          "name": "test (ubuntu-latest) / Test (ubuntu-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        },
        {
          "name": "test (windows-latest) / Test (windows-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        },
        {
          "name": "test (macos-latest) / Test (macos-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        },
        {
          "name": "verify / Node (Ubuntu)",
          "paths": [
            "package.json",
            "package-lock.json",
            "src/**",
            "server.ts",
            "vite.config.ts",
            "tsconfig.json",
            "index.html"
          ]
        }
      ]
    },
    "lagvex": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify (Lagvex Go)",
        "🔨 Cross-Compile Check (linux, amd64, bin/lagvex-client-linux-amd64)",
        "🔨 Cross-Compile Check (windows, amd64, bin/lagvex-client.exe)",
        "🔨 Cross-Compile Check (darwin, arm64, bin/lagvex-client-darwin-arm64)",
        "🔨 Cross-Compile Check (linux, amd64, bin/lagvex-relay, ./cmd/lagvex-relay)",
        "🔨 Cross-Compile Check (darwin, amd64, bin/lagvex-client-darwin-amd64)"
      ]
    },
    "git-account-switcher": {
      "defaultBranch": "master",
      "requiredChecks": [
        "Bash (ubuntu-latest)",
        "Windows PowerShell",
        "Bash (macos-latest)"
      ]
    },
    "ClipForge": {
      "defaultBranch": "main",
      "requiredChecks": [
        "build-test-ubuntu / 🐧 g++ C++ backend (ubuntu)",
        "🪟 MSVC + NASM (windows)",
        "🔖 Version consistency"
      ]
    },
    "WriteCanvas": {
      "defaultBranch": "master",
      "requiredChecks": [
        "tests (ubuntu-latest, 22.x) / ubuntu-latest / node 22.x",
        "tests (ubuntu-latest, 24.x) / ubuntu-latest / node 24.x",
        "tests (windows-latest, 22.x) / windows-latest / node 22.x",
        "tests (macos-latest, 22.x) / macos-latest / node 22.x",
        "syntax / syntax check"
      ]
    },
    "Techstack-Studio": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify"
      ]
    },
    "StepDSA": {
      "defaultBranch": "main",
      "requiredChecks": [
        "test / test"
      ]
    },
    "SkillGauge": {
      "defaultBranch": "main",
      "pendingLabel": "skill-verification-pending",
      "requiredChecks": [
        {
          "name": "verify",
          "paths": [
            "skills/**/*.md"
          ]
        },
        "verify / Verify (SkillGauge)",
        {
          "name": "skillgauge/verification",
          "kind": "status",
          "paths": [
            "skills/**/*.md"
          ]
        }
      ],
      "reviewHoldLabel": "skill-verification-review",
      "autoMerge": {
        "label": "automerge",
        "branchPrefix": "contrib-",
        "sameRepository": true,
        "paths": [
          "skills/**/*.md"
        ],
        "allowTriageBypass": true,
        "deferUntilHandoff": true
      }
    },
    "ForgeHelm": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify (ForgeHelm)"
      ]
    },
    "ThanhNguyxnOrg.github.io": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify (Website)"
      ]
    },
    "AFTERFRAME-THE-LAST-LOOP": {
      "defaultBranch": "main",
      "requiredChecks": [
        "verify / Verify (Bun)"
      ]
    },
    "chess-on-glass": {
      "defaultBranch": "main",
      "requiredChecks": []
    },
    "chromadna": {
      "defaultBranch": "main",
      "requiredChecks": [
        "test (ubuntu-latest, 3.10)",
        "test (ubuntu-latest, 3.11)",
        "test (ubuntu-latest, 3.12)",
        "test (windows-latest, 3.10)",
        "test (windows-latest, 3.11)",
        "test (windows-latest, 3.12)",
        "test (macos-latest, 3.10)",
        "test (macos-latest, 3.11)",
        "test (macos-latest, 3.12)"
      ]
    }
  }
}
