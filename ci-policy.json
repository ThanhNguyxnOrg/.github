{
  "schemaVersion": 1,
  "organization": "ThanhNguyxnOrg",
  "defaults": {
    "autoMergeDependabot": false,
    "requiredChecks": []
  },
  "repositories": {
    "judgeloom-core": {
      "defaultBranch": "master",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "Lint • Typecheck • Test (Python 3.12)",
        "go-test / Go worker test • vet"
      ]
    },
    "blendops": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "verify / Verify (BlendOps)"
      ]
    },
    "apidex-hub": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        {
          "name": "check-links",
          "paths": [
            "apis/**",
            "scripts/**",
            ".github/workflows/link-checker.yml"
          ]
        },
        {
          "name": "regression-tests / Python Regression Tests",
          "paths": [
            "scripts/**",
            ".github/workflows/script-tests.yml"
          ]
        },
        {
          "name": "lint",
          "paths": [
            "**/*.md",
            ".markdownlint.json",
            ".github/workflows/markdownlint.yml"
          ]
        }
      ]
    },
    "lumeo": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "verify / lint-and-syntax"
      ]
    },
    "cogmint": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "verify / Typecheck"
      ]
    },
    "awesome-cert-sherpa": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "build / Build & Validate"
      ]
    },
    "Snapbooth": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "verify / Smoke & E2E"
      ]
    },
    "Locsight": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "verify / Registry & Release Script",
        "build-tauri (windows-latest, x64)",
        "build-tauri (macos-latest, x64)",
        "build-tauri (ubuntu-latest, x64)"
      ]
    },
    "PurgeKit": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "frontend / Frontend (Svelte & TypeScript)",
        "rust / Rust Compiler Check"
      ]
    },
    "LayoutLingua": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        {
          "name": "test (ubuntu-latest) / Test (ubuntu-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        },
        {
          "name": "test (windows-latest) / Test (windows-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        },
        {
          "name": "test (macos-latest) / Test (macos-latest)",
          "paths": [
            "layoutlingua/**",
            "tests/**",
            "requirements*.txt",
            ".github/workflows/test.yml",
            "*.py"
          ]
        }
      ]
    },
    "lagvex": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "🧪 Tests & Lint",
        "🔨 Cross-Compile Check (linux, amd64, bin/lagvex-client-linux-amd64)",
        "🔨 Cross-Compile Check (windows, amd64, bin/lagvex-client.exe)",
        "🔨 Cross-Compile Check (darwin, arm64, bin/lagvex-client-darwin-arm64)",
        "🔨 Cross-Compile Check (linux, amd64, bin/lagvex-relay, ./cmd/lagvex-relay)"
      ]
    },
    "git-account-switcher": {
      "defaultBranch": "master",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "Bash (ubuntu-latest)",
        "Windows PowerShell",
        "Bash (macos-latest)"
      ]
    },
    "ClipForge": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "build-test-ubuntu / 🐧 g++ C++ backend (ubuntu)",
        "🪟 MSVC + NASM (windows)",
        "🔖 Version consistency"
      ]
    },
    "WriteCanvas": {
      "defaultBranch": "master",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "tests / ubuntu-latest / node 22.x",
        "tests / ubuntu-latest / node 24.x",
        "tests / windows-latest / node 22.x",
        "tests / macos-latest / node 22.x",
        "syntax check"
      ]
    },
    "Techstack-Studio": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "verify / Verify"
      ]
    },
    "StepDSA": {
      "defaultBranch": "main",
      "autoMergeDependabot": true,
      "requiredChecks": [
        "test / test"
      ]
    },
    "SkillGauge": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "pendingLabel": "skill-verification-pending",
      "requiredChecks": [
        {
          "name": "verify",
          "paths": [
            "skills/**/*.md"
          ]
        },
        "verify / Verify (SkillGauge)"
      ]
    },
    "ForgeHelm": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "verify / Verify (ForgeHelm)"
      ]
    },
    "ThanhNguyxnOrg.github.io": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": []
    },
    "AFTERFRAME-THE-LAST-LOOP": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": [
        "verify / Verify (Bun)"
      ]
    },
    "chess-on-glass": {
      "defaultBranch": "main",
      "autoMergeDependabot": false,
      "requiredChecks": []
    }
  }
}
